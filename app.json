{
  "expo": {
    "name": "OrvalMaps",
    "slug": "OrvalMaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brantz.pierre.OrvalMaps",
      "config": {
        "googleMapsApiKey": "AIzaSyBxHHGrAjEJQ3ViA7WtjsSBYOkzzw7BwFg"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orval Maps a besoin de votre position pour afficher les cafés autour de vous.",
        "NSPhotoLibraryUsageDescription": "L'application a besoin d'accéder à vos photos pour uploader l'image d'un café.",
        "NSCameraUsageDescription": "L'application a besoin de la caméra pour prendre une photo du café."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBxHHGrAjEJQ3ViA7WtjsSBYOkzzw7BwFg"
        }
      },
      "edgeToEdgeEnabled": true,
      "package": "com.brantz.pierre.OrvalMaps"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "05e5cfef-83fd-4db5-a354-46790ee4b3b8"
      }
    }
  }
}
